VITE_API_BASE_URL=/api/v1
VITE_GOOGLE_CLIENT_ID={your-google-client-id}

# Server-side only — used by vite.config.ts proxy, not exposed to the browser.
# docker-compose sets this to http://backend:8000 automatically.
# Only set manually if running Vite outside Docker and the backend is elsewhere.
# BACKEND_URL=http://127.0.0.1:8000
